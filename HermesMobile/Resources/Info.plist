<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Hermes Bot</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ai.nousresearch.hermes.mobile.bot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(HERMES_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>HermesAPSEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>HermesAppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>HermesKeychainAccessGroup</key>
	<string>$(KEYCHAIN_ACCESS_GROUP)</string>
	<key>HermesKeychainService</key>
	<string>$(KEYCHAIN_SERVICE)</string>
	<key>HermesURLScheme</key>
	<string>$(HERMES_URL_SCHEME)</string>
	<!-- Plain HTTP reaches local and tailnet hosts only; public hosts still need HTTPS.
	     NSAllowsLocalNetworking covers .local and single-label names. The CIDR entries
	     cover private and Tailscale IPs, which iOS 17+ needs listed explicitly. ts.net
	     covers Tailscale MagicDNS names (tailnet traffic is WireGuard-encrypted).
	     Scheme inference in BotConnection.address(_:) relies on these entries.
	     Never use NSAllowsArbitraryLoads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>127.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>169.254.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>::1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fc00::/7</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fe80::/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hermex connects to your Hermes backend on your local network to load bots and chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hermex needs microphone access to dictate text into the message composer.</string>
	<key>NSCameraUsageDescription</key>
	<string>Hermex needs camera access to capture and attach photos directly in chat.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Hermex uses Face ID to unlock the app when the lock is on.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Hermex needs photo library access to attach images to chat messages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hermex needs permission to save exported workspace images to Photos.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hermex uses speech recognition to turn dictated audio into editable draft text.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Hermex schedules an alarm only when you allow a device request for one in Settings, Device Access.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Hermex reads event titles and times only when you allow a device request for them in Settings, Device Access.</string>
	<key>NSContactsUsageDescription</key>
	<string>Hermex looks up contact names only when you allow a device request for one in Settings, Device Access.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Hermex reads your step total for the last 24 hours only when you allow a device request for it in Settings, Device Access.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Hermex never writes to Health.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Hermex reads your approximate location only when you allow a device request for it in Settings, Device Access.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Hermes Bot</string>
			<key>UTTypeIdentifier</key>
			<string>ai.nousresearch.hermes.mobile.bot</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ai.nousresearch.hermes.mobile.bot+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/DMSans-Variable.ttf</string>
		<string>Fonts/DMSans-Italic-Variable.ttf</string>
		<string>Fonts/Lora-Variable.ttf</string>
		<string>Fonts/Lora-Italic-Variable.ttf</string>
	</array>
</dict>
</plist>
