    "This Hermes host doesn't list MCP servers yet. Update Hermes to see them here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يعرض مضيف Hermes هذا قائمة خوادم MCP بعد. حدّث Hermes لتظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Hermes-Host listet noch keine MCP-Server auf. Aktualisiere Hermes, damit sie hier angezeigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Hermes host doesn't list MCP servers yet. Update Hermes to see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este host de Hermes aún no muestra servidores MCP. Actualiza Hermes para verlos aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این میزبان Hermes هنوز سرورهای MCP را فهرست نمی‌کند. برای دیدن آن‌ها در اینجا Hermes را به‌روزرسانی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet hôte Hermes ne répertorie pas encore les serveurs MCP. Mettez Hermes à jour pour les afficher ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מארח Hermes זה עדיין לא מציג רשימה של שרתי MCP. יש לעדכן את Hermes כדי לראות אותם כאן."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo host Hermes non elenca ancora i server MCP. Aggiorna Hermes per visualizzarli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Hermes ホストはまだ MCP サーバーの一覧を提供していません。ここに表示するには Hermes を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Hermes 호스트는 아직 MCP 서버 목록을 제공하지 않습니다. 여기에서 보려면 Hermes를 업데이트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze Hermes-host toont nog geen MCP-servers. Werk Hermes bij om ze hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten host Hermesa nie udostępnia jeszcze listy serwerów MCP. Zaktualizuj Hermesa, aby zobaczyć ją tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este host do Hermes ainda não lista servidores MCP. Atualize o Hermes para vê-los aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот хост Hermes пока не предоставляет список серверов MCP. Обновите Hermes, чтобы увидеть их здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Hermes ana makinesi henüz MCP sunucularını listelemiyor. Bunları burada görmek için Hermes’i güncelle."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ Hermes ہوسٹ ابھی MCP سرورز کی فہرست نہیں دکھاتا۔ انہیں یہاں دیکھنے کے لیے Hermes اپ ڈیٹ کریں۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Hermes 主機尚未提供 MCP 服務器列表。更新 Hermes 後即可在此查看。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
