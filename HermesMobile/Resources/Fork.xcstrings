      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح Hermex على محادثة جديدة مع هذا الموجّه في حقل الكتابة. لن يُرسل شيء حتى ترسله أنت."
          }
        },
        "de": {
