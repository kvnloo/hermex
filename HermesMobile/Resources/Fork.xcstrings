        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "״%@״ חייב להיות מחרוזת הקסדצימלית."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» deve essere una stringa esadecimale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」には16進数の文字列を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
