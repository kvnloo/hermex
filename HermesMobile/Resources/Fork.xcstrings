            "value": "Hermex couldn’t confirm the host stopped this sign-in. It ends when the code expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex no pudo confirmar que el host detuviera este inicio de sesión. Terminará cuando caduque el código."
