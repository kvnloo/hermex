    "Open Hermex on Tasks so you can choose one and tap Run Now. Nothing runs until you do.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح Hermex على المهام لتختار واحدة وتضغط «تشغيل الآن». لن يعمل شيء حتى تفعل ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet Hermex bei den Aufgaben, damit du eine auswählen und „Jetzt ausführen“ tippen kannst. Es läuft nichts, bis du das tust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hermex on Tasks so you can choose one and tap Run Now. Nothing runs until you do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre Hermex en Tareas para que elijas una y toques Ejecutar ahora. No se ejecuta nada hasta que lo hagas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex را در بخش وظایف باز می‌کند تا یکی را انتخاب کنید و «اجرای فوری» را بزنید. تا این کار را نکنید، چیزی اجرا نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvre Hermex sur les tâches pour que vous en choisissiez une et touchiez Exécuter maintenant. Rien ne s’exécute avant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פותח את Hermex במשימות כדי שתבחרו אחת ותקישו על ״הפעל כעת״. שום דבר לא רץ עד שתעשו זאת."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apre Hermex su Attività per sceglierne una e toccare Esegui ora. Non viene eseguito nulla finché non lo fai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex のタスクを開き、1つ選んで「今すぐ実行」をタップできるようにします。タップするまで何も実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex의 작업 화면을 열어 하나를 선택하고 지금 실행을 탭할 수 있게 합니다. 탭하기 전에는 아무것도 실행되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opent Hermex bij Taken zodat je er een kiest en op Nu uitvoeren tikt. Er wordt niets uitgevoerd tot je dat doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwiera Hermex na zadaniach, abyś wybrał jedno i stuknął Uruchom teraz. Nic się nie uruchomi, dopóki tego nie zrobisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre o Hermex em Tarefas para você escolher uma e tocar em Executar agora. Nada é executado até você fazer isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Открывает Hermex на задачах, чтобы вы выбрали одну и нажали «Запустить сейчас». Ничего не запустится, пока вы этого не сделаете."
          }
        },
        "tr": {
