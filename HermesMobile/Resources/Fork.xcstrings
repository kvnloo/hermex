        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” precisa ser uma string hexadecimal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» должно быть шестнадцатеричной строкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” onaltılık bir dize olmalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏“%@” ہیکساڈیسیمل اسٹرنگ ہونی چاہیے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必須是十六進制字符串。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必须是十六进制字符串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必須是十六進位制字串。"
          }
