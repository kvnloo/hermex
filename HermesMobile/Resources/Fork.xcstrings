    "Use the attached content to fill the relevant document or form fields. Ask before submitting anything.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم المحتوى المرفق لتعبئة حقول المستند أو النموذج المعنية. اسأل قبل إرسال أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fülle mit dem angehängten Inhalt die passenden Dokument- oder Formularfelder aus. Frag nach, bevor du etwas absendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the attached content to fill the relevant document or form fields. Ask before submitting anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa el contenido adjunto para rellenar los campos del documento o formulario correspondientes. Pregunta antes de enviar nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "با محتوای پیوست، فیلدهای مربوط سند یا فرم را پر کن. پیش از ارسال هر چیزی بپرس."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilise le contenu joint pour remplir les champs du document ou du formulaire concernés. Demande avant de soumettre quoi que ce soit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השתמש בתוכן המצורף כדי למלא את שדות המסמך או הטופס הרלוונטיים. שאל לפני שליחת משהו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa il contenuto allegato per compilare i campi pertinenti del documento o del modulo. Chiedi prima di inviare qualsiasi cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添付の内容を使って、該当する書類やフォームの項目を入力してください。何かを送信する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "첨부된 내용으로 관련 문서나 양식 필드를 채워 줘. 무엇이든 제출하기 전에 물어봐."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik de bijgevoegde inhoud om de relevante document- of formuliervelden in te vullen. Vraag het voordat je iets indient."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Użyj załączonej treści, aby wypełnić odpowiednie pola dokumentu lub formularza. Zapytaj, zanim cokolwiek wyślesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use o conteúdo anexado para preencher os campos relevantes do documento ou formulário. Pergunte antes de enviar qualquer coisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заполни по приложенному содержимому нужные поля документа или формы. Спроси, прежде чем что-либо отправлять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekteki içerikle ilgili belge veya form alanlarını doldur. Bir şey göndermeden önce sor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منسلک مواد سے متعلقہ دستاویز یا فارم کے خانے پُر کرو۔ کچھ بھی جمع کرانے سے پہلے پوچھو۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請使用附加的內容填寫相關文件或表單欄位。提交任何內容前請先詢問。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请使用所附内容填写相关文稿或表单字段。提交任何内容之前请先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請使用附加的內容填寫相關文件或表單欄位。提交任何內容之前請先詢問。"
          }
        }
      }
    },
