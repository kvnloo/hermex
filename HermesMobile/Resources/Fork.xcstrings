{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is %@, not a #RRGGBB or #RRGGBBAA color.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قيمة «%@» هي %@، وليست لونًا بتنسيق #RRGGBB أو #RRGGBBAA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ hat den Wert %@. Erwartet wird eine Farbe als #RRGGBB oder #RRGGBBAA."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is %@, not a #RRGGBB or #RRGGBBAA color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» tiene el valor %@, que no es un color #RRGGBB ni #RRGGBBAA."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقدار «%@» برابر %@ است، نه رنگی با قالب #RRGGBB یا #RRGGBBAA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » vaut %@, ce qui n’est pas une couleur au format #RRGGBB ou #RRGGBBAA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הערך של ״%@״ הוא %@, ולא צבע בתבנית #RRGGBB או #RRGGBBAA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» ha il valore %@, che non è un colore #RRGGBB o #RRGGBBAA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」の値は%@です。#RRGGBB または #RRGGBBAA 形式の色ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”의 값 %@은(는) #RRGGBB 또는 #RRGGBBAA 형식의 색상이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘%@’ heeft de waarde %@, geen kleur in de notatie #RRGGBB of #RRGGBBAA."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” ma wartość %@, która nie jest kolorem #RRGGBB ani #RRGGBBAA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” tem o valor %@, que não é uma cor no formato #RRGGBB ou #RRGGBBAA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» имеет значение %@, а не цвет в формате #RRGGBB или #RRGGBBAA."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” için %@ geçerli bir #RRGGBB veya #RRGGBBAA rengi değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏“%@” کی قدر %@ ہے، #RRGGBB یا #RRGGBBAA فارمیٹ کا رنگ نہیں۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”的值為 %@，不是 #RRGGBB 或 #RRGGBBAA 格式的顏色。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”的值为 %@，不是 #RRGGBB 或 #RRGGBBAA 格式的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”的值為 %@，不是 #RRGGBB 或 #RRGGBBAA 格式的顏色。"
          }
        }
      }
    },
    "\"%@\" must be a hex string.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجب أن يكون «%@» نصًا بالنظام الست عشري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ muss eine Hexadezimalzeichenfolge sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" must be a hex string."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» debe ser una cadena hexadecimal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» باید یک رشتهٔ هگزادسیمال باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » doit être une chaîne hexadécimale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "״%@״ חייב להיות מחרוזת הקסדצימלית."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» deve essere una stringa esadecimale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」には16進数の文字列を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”은(는) 16진수 문자열이어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘%@’ moet een hexadecimale tekenreeks zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” musi być ciągiem szesnastkowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” precisa ser uma string hexadecimal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» должно быть шестнадцатеричной строкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” onaltılık bir dize olmalı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏“%@” ہیکساڈیسیمل اسٹرنگ ہونی چاہیے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必須是十六進制字符串。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必须是十六进制字符串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”必須是十六進位制字串。"
          }
        }
      }
    },
