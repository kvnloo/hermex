    "Read from the latest council run in this chat. This view draws it and computes nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مقروء من آخر جلسة للمجلس في هذه الدردشة. هذا العرض يرسمها فقط ولا يحسب شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus der neuesten Ratssitzung in diesem Chat gelesen. Diese Ansicht zeigt sie nur an und berechnet nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the latest council run in this chat. This view draws it and computes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leído de la última sesión del consejo en este chat. Esta vista solo la dibuja y no calcula nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از آخرین جلسه شورا در این گفتگو خوانده شد. این نما فقط آن را نمایش می‌دهد و چیزی محاسبه نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lu depuis la dernière séance du conseil de cette conversation. Cette vue l'affiche sans rien calculer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "נקרא מישיבת המועצה האחרונה בצ'אט הזה. התצוגה רק מציגה אותה ואינה מחשבת דבר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Letto dall'ultima seduta del consiglio in questa chat. Questa vista la disegna e non calcola nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このチャットの最新の評議会記録から読み込みました。この画面は表示のみで、計算は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅의 최신 위원회 기록에서 읽었습니다. 이 화면은 표시만 하며 아무것도 계산하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gelezen uit de laatste raadszitting in deze chat. Deze weergave toont die alleen en berekent niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odczytano z ostatnich obrad rady w tym czacie. Ten widok tylko je rysuje i niczego nie oblicza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lido da última sessão do conselho neste chat. Esta tela apenas a desenha e não calcula nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прочитано из последнего заседания совета в этом чате. Этот экран только показывает его и ничего не вычисляет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sohbetteki en son konsey oturumundan okundu. Bu görünüm yalnızca onu çizer, hiçbir şey hesaplamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس چیٹ کے تازہ ترین کونسل اجلاس سے پڑھا گیا۔ یہ منظر صرف اسے دکھاتا ہے اور کچھ حساب نہیں کرتا۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
