    "Research the attached content, verify the important claims, and cite sources.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابحث في المحتوى المرفق، وتحقق من الادعاءات المهمة، واذكر المصادر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recherchiere zum angehängten Inhalt, prüfe die wichtigen Aussagen und nenne Quellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research the attached content, verify the important claims, and cite sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Investiga el contenido adjunto, verifica las afirmaciones importantes y cita las fuentes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دربارهٔ محتوای پیوست پژوهش کن، ادعاهای مهم را بررسی کن و منابع را ذکر کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fais des recherches sur le contenu joint, vérifie les affirmations importantes et cite tes sources."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חקור את התוכן המצורף, אמת את הטענות החשובות וציין מקורות."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approfondisci il contenuto allegato, verifica le affermazioni importanti e cita le fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添付の内容を調査し、重要な主張を検証して、出典を示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "첨부된 내용을 조사하고, 중요한 주장을 검증하고, 출처를 밝혀 줘."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onderzoek de bijgevoegde inhoud, controleer de belangrijke beweringen en vermeld bronnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zbadaj załączoną treść, zweryfikuj ważne twierdzenia i podaj źródła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pesquise o conteúdo anexado, verifique as afirmações importantes e cite as fontes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изучи приложенное содержимое, проверь важные утверждения и укажи источники."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekteki içeriği araştır, önemli iddiaları doğrula ve kaynak göster."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منسلک مواد پر تحقیق کرو، اہم دعووں کی تصدیق کرو اور حوالے دو۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請研究附加的內容、核實重要的說法，並註明來源。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请研究所附内容，核实重要论断，并注明来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請研究附加的內容、驗證重要的主張，並註明來源。"
          }
        }
      }
    },
