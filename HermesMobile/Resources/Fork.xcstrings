    "Configured in the Profile's config.yaml or by plugins. Hermex shows them read-only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُضبط هذه الخوادم في ملف config.yaml الخاص بملف التعريف أو عبر الإضافات. يعرضها Hermex للقراءة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Im Profil über config.yaml oder durch Plug-ins konfiguriert. In Hermex kannst du sie nur ansehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configured in the Profile's config.yaml or by plugins. Hermex shows them read-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se configuran en el archivo config.yaml del perfil o mediante complementos. Hermex los muestra en modo de solo lectura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این سرورها در config.yaml نمایه یا با افزونه‌ها پیکربندی می‌شوند. در Hermex فقط قابل مشاهده‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils sont configurés dans le fichier config.yaml du profil ou par des extensions. Hermex les affiche en lecture seule."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השרתים מוגדרים בקובץ config.yaml של הפרופיל או באמצעות תוספים. Hermex מציגה אותם לקריאה בלבד."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sono configurati nel file config.yaml del profilo o tramite plugin. Hermex li mostra in sola lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロファイルの config.yaml またはプラグインで設定します。Hermex では閲覧のみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로필의 config.yaml 또는 플러그인에서 설정합니다. Hermex에서는 읽기 전용으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ze worden geconfigureerd in config.yaml van het profiel of via plug-ins. Hermex toont ze alleen-lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfiguracja pochodzi z pliku config.yaml profilu lub z wtyczek. Hermex wyświetla ją tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "São configurados no arquivo config.yaml do perfil ou por plugins. O Hermex os exibe somente para leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Настраиваются в config.yaml профиля или через плагины. В Hermex их можно только просматривать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilin config.yaml dosyasında veya eklentiler aracılığıyla yapılandırılır. Hermex bunları salt okunur gösterir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ سرورز پروفائل کی config.yaml فائل یا پلگ اِنز کے ذریعے ترتیب دیے جاتے ہیں۔ Hermex میں انہیں صرف دیکھا جا سکتا ہے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在設定檔的 config.yaml 文件中或通過插件配置。Hermex 僅提供只讀查看。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在个人配置的 config.yaml 文件中或通过插件配置。Hermex 仅提供只读查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在設定檔的 config.yaml 檔案中或透過外掛配置。Hermex 僅提供只讀檢視。"
          }
        }
      }
    },
