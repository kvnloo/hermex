    "Connects to the server on the host, lists its tools, and disconnects.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتصل بالخادم على المضيف ويعرض قائمة أدواته، ثم يقطع الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stellt auf dem Host eine Verbindung zum Server her, listet seine Tools auf und trennt die Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects to the server on the host, lists its tools, and disconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se conecta al servidor en el host, enumera sus herramientas y se desconecta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "به سرور روی میزبان وصل می‌شود، ابزارهای آن را فهرست می‌کند و اتصال را قطع می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se connecte au serveur sur l’hôte, répertorie ses outils, puis se déconnecte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מתחבר לשרת על המארח, מציג את רשימת הכלים שלו ומתנתק."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si connette al server sull’host, ne elenca gli strumenti e si disconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホスト上のサーバーに接続し、ツールを一覧表示してから切断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호스트의 서버에 연결해 도구 목록을 가져온 뒤 연결을 끊습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maakt verbinding met de server op de host, toont de tools en verbreekt de verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Łączy się z serwerem na hoście, pobiera listę narzędzi i rozłącza się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecta ao servidor no host, lista as ferramentas e encerra a conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключается к серверу на хосте, получает список инструментов и отключается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana makinedeki sunucuya bağlanır, araçlarını listeler ve bağlantıyı keser."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ہوسٹ پر سرور سے جڑتا ہے، اس کے ٹولز کی فہرست دکھاتا ہے اور پھر کنکشن منقطع کر دیتا ہے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連接到主機上的服務器，列出其工具，然後斷開連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接到主机上的服务器，列出其工具，然后断开连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連線到主機上的伺服器，列出其工具，然後斷開連線。"
          }
        }
      }
    },
