    "Make a Hermes server active in Hermex to open its Tasks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اجعل خادم Hermes نشطًا في Hermex لفتح مهامه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere in Hermex einen Hermes-Server, um seine Aufgaben zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a Hermes server active in Hermex to open its Tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa un servidor de Hermes en Hermex para abrir sus tareas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای باز کردن وظایف، یک سرور Hermes را در Hermex فعال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez un serveur Hermes dans Hermex pour ouvrir ses tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעילו שרת Hermes ב־Hermex כדי לפתוח את המשימות שלו."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rendi attivo un server Hermes in Hermex per aprirne le attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タスクを開くには、Hermex で Hermes サーバをアクティブにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업을 열려면 Hermex에서 Hermes 서버를 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak in Hermex een Hermes-server actief om de taken ervan te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustaw serwer Hermes jako aktywny w Hermex, aby otworzyć jego zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative um servidor do Hermes no Hermex para abrir as tarefas dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сделайте сервер Hermes активным в Hermex, чтобы открыть его задачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görevlerini açmak için Hermex’te bir Hermes sunucusunu etkin yapın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس کے ٹاسکس کھولنے کے لیے Hermex میں کسی Hermes سرور کو فعال کریں۔"
