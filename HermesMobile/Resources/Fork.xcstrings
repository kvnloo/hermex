    "Save the durable facts from the attached content to memory, then confirm what was kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احفظ الحقائق الدائمة من المحتوى المرفق في الذاكرة، ثم أكّد ما تم حفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere die dauerhaften Fakten aus dem angehängten Inhalt im Gedächtnis und bestätige dann, was behalten wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the durable facts from the attached content to memory, then confirm what was kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda en la memoria los datos duraderos del contenido adjunto y luego confirma lo que se conservó."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "واقعیت‌های ماندگار محتوای پیوست را در حافظه ذخیره کن، سپس تأیید کن چه چیزهایی نگه داشته شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistre en mémoire les faits durables du contenu joint, puis confirme ce qui a été conservé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שמור בזיכרון את העובדות הקבועות מהתוכן המצורף, ואז אשר מה נשמר."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva in memoria i fatti duraturi del contenuto allegato, poi conferma cosa è stato conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添付の内容から長く役立つ事実をメモリに保存し、何を残したかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "첨부된 내용에서 오래 유지할 사실을 메모리에 저장한 뒤, 무엇을 남겼는지 확인해 줘."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sla de blijvende feiten uit de bijgevoegde inhoud op in het geheugen en bevestig daarna wat is bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisz w pamięci trwałe fakty z załączonej treści, a potem potwierdź, co zachowano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve na memória os fatos duradouros do conteúdo anexado e depois confirme o que foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохрани в память устойчивые факты из приложенного содержимого, затем подтверди, что сохранено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekteki içerikteki kalıcı bilgileri belleğe kaydet, sonra neyin tutulduğunu onayla."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منسلک مواد کے مستقل حقائق میموری میں محفوظ کرو، پھر بتاؤ کیا رکھا گیا۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請將附加內容中的長期事實存入記憶，然後確認保留了哪些。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请将所附内容中的持久事实保存到记忆中，然后确认保留了哪些内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請將附加內容中的長期事實儲存到記憶中，然後確認保留了哪些內容。"
          }
        }
      }
    },
