    "This Hermes host doesn't list MCP servers yet. Update Hermes to see them here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يعرض مضيف Hermes هذا قائمة خوادم MCP بعد. حدّث Hermes لتظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Hermes-Host listet noch keine MCP-Server auf. Aktualisiere Hermes, damit sie hier angezeigt werden."
          }
        },
