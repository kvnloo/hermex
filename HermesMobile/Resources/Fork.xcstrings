        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex non ha potuto confermare che l’host abbia interrotto questo accesso. Terminerà alla scadenza del codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホストがこのサインインを停止したことを Hermex で確認できませんでした。コードの有効期限が切れると終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호스트가 이 로그인을 중단했는지 Hermex가 확인하지 못했습니다. 코드가 만료되면 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
