    "Pausing stops new workers from starting. Running workers carry on.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمنع الإيقاف المؤقت بدء عمليات عاملة جديدة. وتستمر العمليات الجارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pausieren verhindert, dass neue Worker starten. Laufende Worker arbeiten weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing stops new workers from starting. Running workers carry on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pausar impide que se inicien workers nuevos. Los que ya se ejecutan continúan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف موقت از شروع عامل‌های جدید جلوگیری می‌کند. عامل‌های در حال اجرا ادامه می‌دهند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pause empêche le démarrage de nouveaux workers. Ceux en cours continuent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השהיה מונעת הפעלה של תהליכי עבודה חדשים. תהליכים פעילים ממשיכים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pausa impedisce l’avvio di nuovi worker. Quelli in esecuzione continuano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一時停止すると新しいワーカーは開始されません。実行中のワーカーは続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일시 정지하면 새 워커가 시작되지 않습니다. 실행 중인 워커는 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pauzeren voorkomt dat nieuwe workers starten. Lopende workers gaan door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wstrzymanie blokuje uruchamianie nowych procesów roboczych. Działające pracują dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pausar impede que novos workers comecem. Os que estão em execução continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пауза не даёт запускать новые воркеры. Запущенные продолжают работу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Duraklatmak yeni worker'ların başlamasını engeller. Çalışanlar devam eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "روکنے سے نئے ورکرز شروع نہیں ہوتے۔ چلتے ورکرز جاری رہتے ہیں۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暫停後不會啟動新工作程序，執行中的會繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂停后不会启动新的工作进程，正在运行的会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暫停後不會啟動新的工作程序，執行中的會繼續。"
          }
        }
      }
    },
