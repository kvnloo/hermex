    "Hermex couldn’t confirm the host stopped this sign-in. It ends when the code expires.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر على Hermex التأكد من أن الخادم أوقف تسجيل الدخول هذا. سينتهي عند انتهاء صلاحية الرمز."
          }
        },
        "de": {
          "stringUnit": {
