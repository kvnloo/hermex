    "Demo run with synthetic seats and brief. A reply that quotes a glide.council-run/v1 run replaces it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جلسة تجريبية بمقاعد وموجز مصطنعة. يحل محلها رد يقتبس جلسة glide.council-run/v1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demo mit erfundenen Sitzen und Vorlage. Eine Antwort, die eine glide.council-run/v1-Sitzung zitiert, ersetzt sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo run with synthetic seats and brief. A reply that quotes a glide.council-run/v1 run replaces it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesión de demostración con asientos y planteamiento ficticios. Una respuesta que cite una sesión glide.council-run/v1 la sustituye."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جلسه نمایشی با کرسی‌ها و موضوع ساختگی. پاسخی که یک جلسه glide.council-run/v1 را نقل کند جایگزین آن می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Séance de démonstration avec sièges et question fictifs. Une réponse citant une séance glide.council-run/v1 la remplace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ישיבת הדגמה עם מושבים ותדריך בדויים. תשובה שמצטטת ישיבת glide.council-run/v1 תחליף אותה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seduta dimostrativa con seggi e quesito fittizi. Una risposta che cita una seduta glide.council-run/v1 la sostituisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "架空の席と議題によるデモです。glide.council-run/v1 の記録を引用した返信があれば置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가상의 자리와 안건으로 구성된 데모입니다. glide.council-run/v1 기록을 인용한 답변이 있으면 대체됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demozitting met verzonnen zetels en opdracht. Een antwoord dat een glide.council-run/v1-zitting citeert, vervangt die."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrady demonstracyjne z fikcyjnymi miejscami i zagadnieniem. Zastąpi je odpowiedź cytująca obrady glide.council-run/v1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessão de demonstração com assentos e questão fictícios. Uma resposta que cite uma sessão glide.council-run/v1 a substitui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демонстрационное заседание с вымышленными местами и вопросом. Его заменит ответ, цитирующий заседание glide.council-run/v1."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uydurma koltuklar ve gündemle demo oturumu. glide.council-run/v1 oturumu alıntılayan bir yanıt onun yerini alır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فرضی نشستوں اور خلاصے کے ساتھ ڈیمو اجلاس۔ glide.council-run/v1 اجلاس کا حوالہ دینے والا جواب اس کی جگہ لے لیتا ہے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用虛構席位和議題的示範。引用 glide.council-run/v1 記錄的回覆會取代它。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用虚构席位和议题的演示。引用 glide.council-run/v1 记录的回复会替换它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用虛構席位和議題的示範。引用 glide.council-run/v1 記錄的回覆會取代它。"
          }
        }
      }
    },
