    "Health doesn't tell apps whether reading is allowed. If it isn't, steps come back empty.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُعلم تطبيق الصحة التطبيقات بما إذا كانت القراءة مسموحة. إذا لم تكن مسموحة، تعود الخطوات فارغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Health teilt Apps nicht mit, ob Lesen erlaubt ist. Wenn nicht, kommen die Schritte leer zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health doesn't tell apps whether reading is allowed. If it isn't, steps come back empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salud no indica a las apps si se permite la lectura. Si no se permite, los pasos llegan vacíos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برنامهٔ سلامت به برنامه‌ها نمی‌گوید که خواندن مجاز است یا نه. اگر مجاز نباشد، قدم‌ها خالی برمی‌گردند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Santé n’indique pas aux apps si la lecture est autorisée. Si elle ne l’est pas, les pas reviennent vides."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Health לא מודיע לאפליקציות אם הקריאה מותרת. אם לא, הצעדים יחזרו ריקים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salute non comunica alle app se la lettura è consentita. Se non lo è, i passi risultano vuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ヘルスケアは読み取りが許可されているかをアプリに知らせません。許可されていない場合、歩数は空で返されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "건강 앱은 읽기가 허용되었는지 앱에 알려 주지 않습니다. 허용되지 않으면 걸음 수가 비어 있게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gezondheid vertelt apps niet of lezen is toegestaan. Als dat niet zo is, komen de stappen leeg terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zdrowie nie informuje aplikacji, czy odczyt jest dozwolony. Jeśli nie jest, kroki wracają puste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Saúde não informa aos apps se a leitura é permitida. Se não for, os passos voltam vazios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
