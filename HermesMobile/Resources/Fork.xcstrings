    "This Hermes host didn’t return its sign-in providers. Update Hermes and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُرجع خادم Hermes هذا مزوّدي تسجيل الدخول. حدّث Hermes وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Hermes-Host hat seine Anmeldeanbieter nicht zurückgegeben. Aktualisiere Hermes und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Hermes host didn’t return its sign-in providers. Update Hermes and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este host de Hermes no devolvió sus proveedores de inicio de sesión. Actualiza Hermes e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "این میزبان Hermes ارائه‌دهندگان ورود خود را برنگرداند. Hermes را به‌روز کنید و دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet hôte Hermes n’a pas renvoyé ses fournisseurs de connexion. Mettez Hermes à jour et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שרת Hermes הזה לא החזיר את ספקי ההתחברות שלו. עדכנו את Hermes ונסו שוב."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo host Hermes non ha restituito i suoi fornitori di accesso. Aggiorna Hermes e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Hermes ホストはサインインプロバイダを返しませんでした。Hermes をアップデートしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Hermes 호스트가 로그인 제공자를 반환하지 않았습니다. Hermes를 업데이트하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
