    "Approval received. The host saved the credentials; Hermex can’t verify which account they belong to.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم استلام الموافقة. حفظ الخادم بيانات الاعتماد؛ لا يمكن لـ Hermex التحقق من الحساب الذي تخصه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Freigabe erhalten. Der Host hat die Zugangsdaten gesichert; Hermex kann nicht prüfen, zu welchem Konto sie gehören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval received. The host saved the credentials; Hermex can’t verify which account they belong to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprobación recibida. El host guardó las credenciales; Hermex no puede verificar a qué cuenta pertenecen."
          }
