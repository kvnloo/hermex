    "Double-tap to pause, resume, or interrupt the reply.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر مرتين لإيقاف الرد مؤقتًا أو استئنافه أو مقاطعته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe zweimal, um die Antwort anzuhalten, fortzusetzen oder zu unterbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to pause, resume, or interrupt the reply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca dos veces para pausar, reanudar o interrumpir la respuesta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برای مکث، ادامه یا قطع پاسخ دوبار ضربه بزنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez deux fois pour mettre en pause, reprendre ou interrompre la réponse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להקיש פעמיים כדי להשהות את התשובה, להמשיך אותה או לקטוע אותה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca due volte per mettere in pausa, riprendere o interrompere la risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ダブルタップで一時停止、再開、または応答を中断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "두 번 탭하면 일시 정지하거나 재개하거나 응답을 중단합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik dubbel om het antwoord te pauzeren, te hervatten of te onderbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stuknij dwukrotnie, aby wstrzymać lub wznowić tryb albo przerwać odpowiedź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque duas vezes para pausar, retomar ou interromper a resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дважды коснитесь, чтобы приостановить, продолжить или прервать ответ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Duraklatmak, sürdürmek veya yanıtı kesmek için iki kez dokun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جواب روکنے، دوبارہ جاری کرنے یا درمیان میں بند کرنے کے لیے دو بار ٹیپ کریں۔"
