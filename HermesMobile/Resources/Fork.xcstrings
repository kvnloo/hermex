    "Extract the decisions, deadlines, owners, and action items from the attached content.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخرج القرارات والمواعيد النهائية والمسؤولين وبنود العمل من المحتوى المرفق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zieh die Entscheidungen, Fristen, Verantwortlichen und To-dos aus dem angehängten Inhalt heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract the decisions, deadlines, owners, and action items from the attached content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Extrae las decisiones, plazos, responsables y tareas pendientes del contenido adjunto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تصمیم‌ها، مهلت‌ها، مسئولان و اقدام‌ها را از محتوای پیوست استخراج کن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Extrais les décisions, échéances, responsables et actions à mener du contenu joint."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חלץ מהתוכן המצורף את ההחלטות, המועדים, האחראים ופריטי הפעולה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estrai decisioni, scadenze, responsabili e azioni da fare dal contenuto allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添付の内容から、決定事項、期限、担当者、アクションアイテムを抽出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "첨부된 내용에서 결정 사항, 마감일, 담당자, 실행 항목을 추출해 줘."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haal de besluiten, deadlines, eigenaars en actiepunten uit de bijgevoegde inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyodrębnij z załączonej treści decyzje, terminy, osoby odpowiedzialne i zadania do wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Extraia as decisões, prazos, responsáveis e itens de ação do conteúdo anexado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выдели из приложенного содержимого решения, сроки, ответственных и задачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekteki içerikten kararları, son tarihleri, sorumluları ve yapılacak işleri çıkar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منسلک مواد سے فیصلے، آخری تاریخیں، ذمہ داران اور کرنے کے کام نکالو۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請從附加的內容中擷取決定、期限、負責人和待辦事項。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
