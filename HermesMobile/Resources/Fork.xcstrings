        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأیید دریافت شد. میزبان اعتبارنامه‌ها را ذخیره کرد؛ Hermex نمی‌تواند بررسی کند متعلق به کدام حساب‌اند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approbation reçue. L’hôte a enregistré les identifiants ; Hermex ne peut pas vérifier à quel compte ils appartiennent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "האישור התקבל. השרת שמר את פרטי הגישה; Hermex לא יכול לאמת לאיזה חשבון הם שייכים."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approvazione ricevuta. L’host ha salvato le credenziali; Hermex non può verificare a quale account appartengano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "承認を受け取りました。ホストが認証情報を保存しました。Hermex はどのアカウントのものかを確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "승인을 받았습니다. 호스트가 자격 증명을 저장했으며, Hermex는 어떤 계정의 것인지 확인할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Goedkeuring ontvangen. De host heeft de inloggegevens bewaard; Hermex kan niet controleren bij welk account ze horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otrzymano zgodę. Host zapisał dane logowania; Hermex nie może sprawdzić, do którego konta należą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprovação recebida. O host salvou as credenciais; o Hermex não consegue verificar a qual conta elas pertencem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтверждение получено. Хост сохранил учётные данные; Hermex не может проверить, какому аккаунту они принадлежат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onay alındı. Sunucu kimlik bilgilerini kaydetti; Hermex bunların hangi hesaba ait olduğunu doğrulayamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
