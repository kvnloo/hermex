    "The host can pause new workers, not a running one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن للخادم إيقاف العمليات العاملة الجديدة مؤقتًا، لا عملية قيد التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Host kann neue Worker pausieren, aber keinen laufenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host can pause new workers, not a running one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El host puede pausar workers nuevos, no uno en ejecución."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "میزبان می‌تواند عامل‌های جدید را متوقف کند، نه عاملی که در حال اجراست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’hôte peut mettre en pause les nouveaux workers, pas un worker en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המארח יכול להשהות תהליכי עבודה חדשים, לא תהליך שכבר פועל."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’host può mettere in pausa i nuovi worker, non uno in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホストが一時停止できるのは新しいワーカーだけで、実行中のワーカーは対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호스트는 새 워커를 일시 정지할 수 있지만 실행 중인 워커는 할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De host kan nieuwe workers pauzeren, geen lopende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Host może wstrzymać nowe procesy robocze, ale nie działający."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O host pode pausar novos workers, não um em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хост может приостановить новые воркеры, но не запущенный."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sunucu yeni worker'ları duraklatabilir, çalışan birini değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ہوسٹ نئے ورکرز روک سکتا ہے، چلتے ہوئے ورکر کو نہیں۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主機只能暫停新工作程序，無法暫停執行中的。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主机只能暂停新的工作进程，无法暂停正在运行的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主機只能暫停新的工作程序，無法暫停執行中的。"
          }
        }
      }
    },
