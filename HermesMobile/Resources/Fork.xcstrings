    "Solid replaces Liquid Glass on bars and buttons with a frosted material.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستبدل النمط المصمت Liquid Glass على الأشرطة والأزرار بمادة ذات مظهر مطفأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matt ersetzt Liquid Glass in Leisten und auf Tasten durch eine Milchglasoptik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid replaces Liquid Glass on bars and buttons with a frosted material."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estilo Mate sustituye Liquid Glass en barras y botones por un material esmerilado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سبک مات، Liquid Glass را در نوارها و دکمه‌ها با نمایی شبیه شیشهٔ مات جایگزین می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le style mat remplace Liquid Glass sur les barres et les boutons par un matériau dépoli."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הסגנון האטום מחליף את Liquid Glass בסרגלים ובכפתורים במראה של זכוכית חלבית."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo stile opaco sostituisce Liquid Glass su barre e pulsanti con un materiale satinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マットでは、バーとボタンの Liquid Glass がすりガラス風の素材に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "무광을 선택하면 막대와 버튼의 Liquid Glass가 서리 유리 질감으로 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De matte stijl vervangt Liquid Glass op balken en knoppen door matglas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matowe zastępuje Liquid Glass na paskach i przyciskach matowym materiałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O estilo Fosco substitui o Liquid Glass nas barras e nos botões por um material acetinado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В матовом оформлении Liquid Glass на панелях и кнопках заменяется матовым материалом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mat seçeneği, çubuk ve düğmelerdeki Liquid Glass efektini buzlu bir malzemeyle değiştirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ٹھوس انداز بارز اور بٹنوں پر Liquid Glass کی جگہ دھندلے شیشے جیسی تہہ لگاتا ہے۔"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "磨砂樣式會將欄和按鈕上的 Liquid Glass 替換為磨砂材質。"
          }
        },
        "zh-Hans": {
